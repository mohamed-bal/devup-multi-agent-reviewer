    "capture": "node src/capture.mts",
    "score": "node src/score.mts"
  },
  "dependencies": {
    "@openai/agents": "0.20.0",
    "openai": "7.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
