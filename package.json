{
  "name": "devup-multi-agent-reviewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A bounded, read-only code review lab with a single-agent baseline.",
  "engines": { "node": ">=24" },
  "scripts": {
    "test": "node --test tests/*.test.mts",
    "typecheck": "tsc --noEmit",
